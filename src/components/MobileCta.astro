---
import { SITE } from '../lib/site';

/*
  On phones the primary conversion action was disappearing into the hamburger.
  For a firm whose next step is a booked, paid assessment, burying "Book an
  assessment" behind a menu tap costs enquiries that never announce themselves.

  Two actions, always reachable. Call sits first because it is the higher-intent
  channel and the one that works with no further typing.

  Only below 640px, the same breakpoint at which the nav collapses — above it
  the header CTA is already visible and a second one would be noise.
*/
---
<div class="mcta">
  <a class="mcta-call" href={SITE.phoneHref}>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.6 2.8a2 2 0 0 1-.4 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    Call
  </a>
  <a class="mcta-book" href="/assessment/">Book an assessment</a>
</div>

<style>
  .mcta{
    display:none;
    position:fixed;left:0;right:0;bottom:0;z-index:90;
    gap:.6rem;padding:.7rem var(--pad);
    /* Clear the iPhone home indicator rather than sitting under it. */
    padding-bottom:calc(.7rem + env(safe-area-inset-bottom,0px));
    background:rgba(242,245,251,.92);
    backdrop-filter:blur(16px) saturate(160%);
    border-top:1px solid var(--rule);
    box-shadow:0 -8px 24px -18px rgba(12,21,48,.5);
  }
  .mcta a{
    display:flex;align-items:center;justify-content:center;gap:.45rem;
    padding:.85rem 1rem;border-radius:4px;
    font-size:.95rem;font-weight:600;text-decoration:none;
    /* Comfortably past the 44px minimum touch target. */
    min-height:48px;
  }
  .mcta-call{flex:0 0 auto;min-width:6.5rem;color:var(--indigo);border:1.5px solid var(--rule);background:var(--white)}
  .mcta-book{flex:1 1 auto;background:var(--indigo);color:#fff}
  .mcta-book:active{background:var(--indigo-deep)}

  @media (max-width:640px){ .mcta{display:flex} }

  /* Printing a fixed bar over the page is never what anyone wants. */
  @media print{ .mcta{display:none} }
</style>
