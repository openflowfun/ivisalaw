---
/*
  A video used as a section background.

  Ambient and silent: muted, looping, behind the same AA-tuned scrim as the
  photo backgrounds (global.css §6c), so the headline stays legible over
  every frame. There are no on-page controls and the file carries no audio
  track. Reduced-motion and Save-Data visitors never start it and keep the
  still poster instead.

  The video file never loads until script decides it should: preload="none"
  and no autoplay attribute. That keeps ~4MB of video away from phones (where
  the scrim is a flat 96% wash and the video would be invisible), away from
  Save-Data and reduced-motion visitors, and out of the critical path
  everywhere else. See wireBgVideo() in scripts/site.ts.

  Paths are root-relative; scripts/rebase-for-pages.mjs rewrites src and
  poster for the GitHub Pages preview.
*/
interface Props {
  /** Root-relative path to an MP4 in /public. */
  src: string;
  /** Root-relative path to the first frame, so nothing jumps on play. */
  poster: string;
  scrim?: 'light' | 'dark';
  anchor?: 'left' | 'full';
}
const { src, poster, scrim = 'light', anchor = 'left' } = Astro.props;
---
<div class="bgv" data-bgv aria-hidden="true">
  <video
    muted
    loop
    playsinline
    preload="none"
    poster={poster}
    tabindex="-1"
    disablepictureinpicture
  >
    <source src={src} type="video/mp4" />
  </video>
  <span class:list={['bg-scrim', scrim, anchor]}></span>
</div>

<style>
  .bgv{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0}
  .bgv video{width:100%;height:100%;object-fit:cover;object-position:center;display:block}
</style>
