---
import { NAV } from '../lib/site';

const path = Astro.url.pathname;
/** Mark the section, not just the exact page, so /work-visas/aewv/ lights up "Work visas". */
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class="masthead" id="mast">
  <div class="wrap">
    <a class="brand" href="/"><span class="i">i</span><span class="word">VISALAW</span></a>
    <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav class="nav" id="nav" aria-label="Primary">
      {NAV.map(item => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn" href="/assessment/">Book an assessment</a>
    </nav>
  </div>
</header>
