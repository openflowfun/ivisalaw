---
import { Image } from 'astro:assets';
import { SITE } from '../../lib/site';

/* Portraits live in src/assets/team/<name-as-slug>.jpg. Drop a larger original
   over any of them and it is picked up on the next build. */
const portraits = import.meta.glob<{ default: ImageMetadata }>('../../assets/team/*.jpg', { eager: true });
const portraitFor = (name: string) =>
  portraits[`../../assets/team/${name.toLowerCase().replace(/[^a-z]+/g, '-')}.jpg`]?.default;

/*
  Roles and licences come from the firm's own video, and agree with an
  independent directory listing of the practice: two licensed advisers,
  Bob Fenwick (200800177) and Sakina Silva (202300655). The first draft had
  three unlicensed staff down as licensed advisers. That is not a style
  problem — holding someone out as a licensed immigration adviser when they
  are not is an offence under the Immigration Advisers Licensing Act 2007.

  So: a licence number appears only for someone shown holding one, and
  everyone else is listed by their actual role with no licence line at all.
  Nobody is described as "supervised" — that wording belongs to provisional
  licence holders, and implies the office team gives immigration advice.

  Jessica Kim holds a provisional licence (202603871), per the firm's own
  current About page. The video predates it and shows her as an Immigration
  Assistant, as did the directory snapshot — a 2026 licence number explains
  both. The class is shown explicitly: a provisional licence is a licence
  under the Act, but saying "provisional" is what keeps the claim exact.

  Still to confirm with the client: Sakina's certificate in the video shows
  an expiry of 16 August 2026, so her current status should be checked on the
  register before launch. The Verify link exists for exactly that reason.

  TITLES ARE NEUTRAL UNTIL THE CLIENT CONFIRMS THEM. The adviser titles below
  are deliberately generic so the page makes no licensing claim in prose. Once
  the client has confirmed each title and the register agrees, restore:
    Bob Fenwick  — 'Founder · Senior Licensed Immigration Adviser'
    Sakina Silva — 'Licensed Immigration Adviser'
    Jessica Kim  — 'Licensed Immigration Adviser (Provisional)'
*/
const people: { name: string; role: string; licence?: string }[] = [
  { name: 'Bob Fenwick', role: 'Founder', licence: '200800177' },
  { name: 'Kanchana Kulasinghe', role: 'Director' },
  { name: 'Sakina Silva', role: 'Team member', licence: '202300655' },
  { name: 'Imaya Munasinghe', role: 'Office Manager' },
  { name: 'Jessica Kim', role: 'Team member', licence: '202603871' },
  { name: 'Julianne Lee', role: 'Student Consultant' },
];
---
<section class="team">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="wipe">The people who will handle your file</h2>
      <p class="rv" data-d="1">Every licensed adviser in New Zealand holds a public licence you can verify. Ours are listed here, with links to the Immigration Advisers Authority register.</p>
    </div>
    <div class="team-grid glow-grid">
      {people.map((p, i) => (
        <div class="person glow rv" data-d={String(i + 1)}>
          {portraitFor(p.name) && (
            <div class="ph">
              <Image src={portraitFor(p.name)} alt={`Portrait of ${p.name}`} width={446} quality={95} loading="lazy" />
            </div>
          )}
          <h3>{p.name}</h3>
          <div class="role">{p.role}</div>
          {p.licence && (
            <div class="lic">IAA {p.licence} &middot; <a href={SITE.iaaRegister}>Verify</a></div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .team{background:var(--white);border-top:1px solid var(--rule)}
  .team-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem 1.75rem}
  .person{border-top:1px solid var(--rule);padding-top:1.35rem;padding-inline:.9rem;margin-inline:-.9rem;border-radius:4px;transition:border-color .5s var(--ease)}
  .person:hover{border-top-color:var(--indigo)}
  .ph{overflow:hidden;border-radius:4px;margin-bottom:1.15rem;border:1px solid var(--rule);background:#F4F6FB;aspect-ratio:446/418}
  .ph :global(img){display:block;width:100%;height:100%;object-fit:cover;transition:transform 1.2s var(--ease)}
  .person:hover .ph :global(img){transform:scale(1.045)}
  .person h3{font-family:var(--serif);font-size:1.38rem;font-weight:400}
  .person .role{margin-top:.4rem;font-size:.9rem;color:var(--ink-2)}
  .person .lic{margin-top:.85rem;font-size:.8rem;color:var(--ink-3);font-variant-numeric:tabular-nums}

  @media (max-width:1000px){ .team-grid{grid-template-columns:repeat(2,1fr)} }
  @media (max-width:640px){ .team-grid{grid-template-columns:1fr} }
</style>
