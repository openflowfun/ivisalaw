---
import Guilloche from '../Guilloche.astro';

/*
  The signature scroll moment. 420vh of track drives a sticky stage;
  scroll progress maps to one of four panes. Unpins entirely below
  1000px and under reduced motion, where the panes stack and read as
  a plain list — see the media queries below and the matching
  innerWidth > 1000 guard in scripts/site.ts.

  Per spec §2: do not add a second pinned section anywhere on the site.
*/
const stages = [
  { n: '01', title: 'Get here lawfully',
    body: 'A work, student or visitor visa with conditions you can actually meet. The wrong first visa quietly closes doors two years later, and by then it is expensive to undo.',
    dur: 'Typically 4–10 weeks' },
  { n: '02', title: 'Build the record',
    body: 'Skilled employment at the right wage, held continuously. This is the evidence every residence decision is actually made on, and it is built long before you apply.',
    dur: 'Typically 2 years' },
  { n: '03', title: 'Apply for residence',
    body: 'Skilled Migrant Category, Green List, or a partnership-based application. Each is assessed on different grounds, and choosing the wrong one costs you months.',
    dur: 'Typically 6–12 months' },
  { n: '04', title: 'Make it permanent',
    body: 'A resident visa carries travel conditions. A permanent resident visa does not. It is the step people forget, and the one that strands them offshore when it lapses.',
    dur: 'After 2 years as a resident' },
];
---
<div class="pin-outer" data-stage="0">
  <Guilloche />
  <div class="pin-track" id="pinTrack">
    <div class="pin-stage">
      <div class="aura" aria-hidden="true"><i></i><i></i></div>

      <div class="wrap head">
        <span class="eyebrow rv"><i></i>The residence pathway</span>
        <h2 class="wipe">Nobody arrives on a resident visa</h2>
        <p class="rv" data-d="1">Residence is the end of a sequence, not the start of one. Knowing which stage you're at, and what the next one demands, is most of the work.</p>
      </div>

      <div class="wrap body">
        <div class="rail" id="rail">
          {stages.map((s, i) => (
            <button
              class:list={['rail-item', i === 0 && 'on']}
              data-i={String(i)}
              id={`rail-${i}`}
              aria-controls={`pane-${i}`}
            >{s.title}</button>
          ))}
        </div>
        <div class="stage-panes" id="panes">
          {stages.map((s, i) => (
            <div class:list={['pane', i === 0 && 'on']} id={`pane-${i}`} aria-labelledby={`rail-${i}`}>
              <div class="num" aria-hidden="true">{s.n}</div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <span class="dur">{s.dur}</span>
            </div>
          ))}
        </div>
        <div class="dial" id="dial" data-n="01" aria-hidden="true">
          <svg viewBox="0 0 200 200">
            <circle class="ring-bg" cx="100" cy="100" r="90" />
            <circle class="ring-fg" cx="100" cy="100" r="90" pathLength="100" />
          </svg>
          <span class="dial-of">of 04</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .pin-outer{background:var(--deep);color:#fff;position:relative}
  .pin-outer :global(.guillo){opacity:.055;left:-18%;right:auto;color:#fff;animation-duration:340s;animation-direction:reverse}

  /* The whole section pins from its first pixel: heading, rail and panes all
     live inside the sticky stage, so there is never an empty screen before
     the stages begin. --p (0 to 1) is written on the track by site.ts. */
  .pin-track{height:420vh;position:relative}
  .pin-stage{position:sticky;top:0;height:100vh;min-height:640px;display:flex;flex-direction:column;justify-content:flex-start;overflow:hidden;padding-block:clamp(4.25rem,9vh,5.75rem) clamp(1.5rem,4vh,3rem)}

  /* atmosphere */
  .aura i{position:absolute;border-radius:50%;pointer-events:none;will-change:transform;transition:transform 1.6s var(--ease),opacity 1.6s var(--ease)}
  .aura i:nth-child(1){width:60vmax;height:60vmax;left:-14vmax;top:-18vmax;background:radial-gradient(closest-side,rgba(76,110,235,.34),rgba(76,110,235,0))}
  .aura i:nth-child(2){width:48vmax;height:48vmax;right:-12vmax;bottom:-20vmax;background:radial-gradient(closest-side,rgba(60,90,220,.3),rgba(60,90,220,0))}
  .pin-outer[data-stage="1"] .aura i:nth-child(1){transform:translate(26vmax,6vmax) scale(.9)}
  .pin-outer[data-stage="1"] .aura i:nth-child(2){transform:translate(-18vmax,-8vmax) scale(1.15)}
  .pin-outer[data-stage="2"] .aura i:nth-child(1){transform:translate(48vmax,22vmax) scale(1.1)}
  .pin-outer[data-stage="2"] .aura i:nth-child(2){transform:translate(-36vmax,-18vmax) scale(.95)}
  .pin-outer[data-stage="3"] .aura i:nth-child(1){transform:translate(20vmax,34vmax) scale(1.25)}
  .pin-outer[data-stage="3"] .aura i:nth-child(2){transform:translate(-10vmax,-4vmax) scale(1.3)}

  .pin-stage .wrap{width:100%}
  /* The heading sits at the top of the stage on its own band, ruled off from
     the stages below so the two never read as one block. */
  .head{position:relative;z-index:1}
  .head::after{content:"";display:block;height:1px;margin-top:clamp(1.25rem,3.2vh,2.25rem);background:linear-gradient(90deg,rgba(255,255,255,.16),rgba(255,255,255,.04))}
  .eyebrow{display:inline-flex;align-items:center;gap:.6rem;font-size:.78rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--indigo-on-ink);margin-bottom:1rem}
  .eyebrow i{width:26px;height:1px;background:var(--indigo-on-ink)}
  .head h2{font-family:var(--serif);font-size:clamp(2rem,4.2vh + 1.2vw,3.2rem);font-weight:350;letter-spacing:-.03em;line-height:1.04;color:#fff;max-width:24ch}
  .head p{margin-top:.9rem;color:#AEB9D8;font-size:1.02rem;max-width:58ch}

  /* One row: rail, stage copy and dial share a single centre line. */
  .body{flex:1;width:100%;display:grid;grid-template-columns:minmax(0,.27fr) minmax(0,.53fr) minmax(0,.2fr);gap:clamp(2rem,5vw,5rem);align-items:center;position:relative;z-index:1}
  .rail{display:flex;flex-direction:column;gap:0;border-left:1px solid rgba(255,255,255,.18);padding-left:1.9rem;position:relative}
  .rail::before{content:"";position:absolute;left:-1px;top:0;width:2px;background:linear-gradient(180deg,var(--indigo-lite),#fff);box-shadow:0 0 14px rgba(185,199,255,.7);height:var(--fill,0%);transition:height .35s linear}
  /* Inactive stages stay muted against the white active one, but readable:
     #68769E measured 4.0:1 on ink; #7584AC is 4.85:1, the same hue lifted. */
  .rail-item{padding:.85rem 0;font-size:.95rem;color:#7584AC;position:relative;transition:color .5s var(--ease),transform .5s var(--ease);cursor:pointer;background:none;border:0;font-family:var(--sans);text-align:left}
  .rail-item::before{content:"";position:absolute;left:calc(-1.9rem - 4px);top:1.25rem;width:7px;height:7px;border-radius:50%;background:#2A3763;transition:background .5s var(--ease),transform .5s var(--ease),box-shadow .5s var(--ease)}
  .rail-item.on{color:#fff;font-weight:600;transform:translateX(6px)}
  .rail-item.on::before{background:var(--indigo-lite);transform:scale(1.6);box-shadow:0 0 0 5px rgba(185,199,255,.18),0 0 16px rgba(185,199,255,.8)}

  /* Panes overlap in one grid cell, so the cell is as tall as the tallest
     pane and the copy sits on the same centre line as the rail and dial. */
  .stage-panes{display:grid;align-items:center}
  .pane{grid-area:1/1;pointer-events:none}
  .pane.on{pointer-events:auto}
  /* Each line of a pane arrives on its own beat. */
  .pane > *{opacity:0;transform:translateY(22px);transition:opacity .5s var(--ease),transform .8s var(--ease)}
  .pane.on > *{opacity:1;transform:none}
  .pane.on > :nth-child(2){transition-delay:.08s}
  .pane.on > :nth-child(3){transition-delay:.16s}
  .pane.on > :nth-child(4){transition-delay:.24s}
  .pane .num{display:none;font-family:var(--serif);font-size:clamp(3.4rem,7vw,5.6rem);line-height:.9;font-weight:300;letter-spacing:-.05em;background:linear-gradient(180deg,#fff 0%,rgba(147,168,244,.35) 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
  .pane h3{font-family:var(--serif);font-size:clamp(2rem,4.2vw,3.1rem);font-weight:350;letter-spacing:-.03em;color:#fff}
  .pane p{margin-top:1.3rem;color:#AEB9D8;font-size:1.08rem;max-width:48ch}
  .pane .dur{margin-top:1.7rem;display:inline-block;font-size:.85rem;color:#fff;border:1px solid rgba(255,255,255,.28);padding:.45rem .95rem;border-radius:100px;background:rgba(185,199,255,.08)}

  /* Progress dial: the ring fills with scroll, the number is the live stage. */
  .dial{position:relative;justify-self:end;width:clamp(130px,14vw,200px);aspect-ratio:1;display:grid;place-items:center;align-content:center}
  .dial svg{position:absolute;inset:0;width:100%;height:100%;rotate:-90deg;overflow:visible}
  .dial circle{fill:none;stroke-width:2.2}
  .ring-bg{stroke:rgba(255,255,255,.14)}
  .ring-fg{stroke:var(--indigo-lite);stroke-linecap:round;stroke-dasharray:100;stroke-dashoffset:calc(100 - var(--p,0) * 100);filter:drop-shadow(0 0 6px rgba(185,199,255,.8))}
  .dial::before{content:attr(data-n);font-family:var(--serif);font-size:clamp(2.6rem,5vw,4.2rem);font-weight:300;letter-spacing:-.04em;line-height:1;color:#fff}
  .dial-of{margin-top:.35rem;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--indigo-on-ink)}

  /* Unpin: the pinned section must not survive below 1000px. */
  @media (max-width:1000px){
    .pin-track{height:auto}
    .pin-stage{position:relative;height:auto;min-height:0;padding-block:clamp(4rem,8vw,6rem) 2rem;gap:2.5rem}
    .body{grid-template-columns:1fr}
    .rail,.dial{display:none}
    .stage-panes{position:static;min-height:0;display:flex;flex-direction:column;gap:3rem}
    .pane{grid-area:auto;pointer-events:auto}
    .pane > *{opacity:1;transform:none}
    .pane .num{display:block}
    .head::after{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    .pin-track{height:auto}
    .pin-stage{position:relative;height:auto;min-height:0;padding-block:clamp(4rem,8vw,6rem) 2rem}
    .body{grid-template-columns:1fr}
    .stage-panes{position:static;display:flex;flex-direction:column;gap:3rem;min-height:0}
    .pane{grid-area:auto;pointer-events:auto}
    .pane > *{opacity:1;transform:none}
    .pane .num{display:block}
    .head::after{display:none}
    .rail,.dial{display:none}
  }
</style>
