---
import { Picture } from 'astro:assets';
import type { Media } from '../content.config';
import Plate from './Plate.astro';

/*
  A reserved image box. Art direction is still open (build spec §6), so
  today every slot renders empty — but it renders at the *exact* final
  aspect ratio, so dropping art in later shifts nothing.

  With no image, the slot renders a guilloche plate rather than a grey hole
  or an empty gap — so the page is art-directed today and a photograph can
  drop in later without the layout moving. Pass `fallback={null}` for slots
  that should collapse entirely instead.

  With an image: Astro's <Picture> emits AVIF + WebP + fallback, with
  width/height baked in so there is no layout shift, lazy by default, and
  an optional LQIP that fades out once the real file decodes.
*/
interface Props {
  media?: Media;
  /** Where this slot sits — shown on the dev placeholder. */
  label: string;
  /** First contentful image on the page should not be lazy. */
  eager?: boolean;
  /* Widths to generate. Without these, <Picture> emits a single candidate
     and the `sizes` attribute has nothing to choose between — a 390px phone
     downloads the same file as a 1440px desktop. */
  widths?: number[];
  /** Plate to draw when no photograph is set. null collapses the slot. */
  fallback?: 'band' | 'panel' | 'quiet' | null;
  /* Aspect ratio for the slot. A photograph carries its own in frontmatter;
     this sets the shape of the reserved box before one exists, so the plate
     and the eventual image occupy the same footprint. Inline style wins over
     any CSS class, so the ratio has to come through here. */
  ratio?: number;
  class?: string;
  sizes?: string;
}

const {
  media,
  label,
  eager = false,
  fallback = 'band',
  ratio: ratioProp,
  widths = [400, 700, 1100, 1536],
  class: extra,
  sizes = '(max-width: 1000px) 100vw, 50vw',
} = Astro.props;

// Only src/assets/** is processed by Astro's image pipeline.
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{avif,webp,png,jpg,jpeg}');
const resolved = media ? images[`/src/assets/${media.src}`] : undefined;
/*
  fallbackFormat is JPEG rather than Astro's default PNG: these slots hold
  photographs with no transparency, and the PNG fallback was emitting 3.4MB
  per image for browsers that in practice no longer exist.
*/
const img = resolved ? (await resolved()).default : undefined;
const ratio = media?.ratio ?? ratioProp ?? 1.5;
---
{img && media ? (
  <figure
    class:list={['slot', media.duotone && 'duotone', extra]}
    style={`--ratio:${ratio}${media.lqip ? `;--lqip:url(${media.lqip})` : ''}`}
  >
    <Picture
      src={img}
      alt={media.alt}
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
    {media.credit && <figcaption>{media.credit}</figcaption>}
  </figure>
) : fallback ? (
  <div class:list={['slot', 'slot-plate', extra]} style={`--ratio:${ratio}`} aria-hidden="true">
    <Plate variant={fallback} />
    {import.meta.env.DEV && <span class="slot-tag">{label} · {ratio.toFixed(2).replace(/\.?0+$/, '')}:1 · plate fallback</span>}
  </div>
) : null}

<style>
  .slot{margin:0;position:relative;aspect-ratio:var(--ratio);overflow:hidden;border-radius:6px;background:var(--rule)}
  .slot :global(img){display:block;width:100%;height:100%;object-fit:cover}

  /* LQIP: blurred placeholder painted behind, revealed until decode. */
  .slot::before{content:'';position:absolute;inset:0;background-image:var(--lqip,none);background-size:cover;filter:blur(18px);transform:scale(1.08)}
  .slot :global(img){position:relative;z-index:1;animation:fade .5s var(--ease) both}
  @keyframes fade{from{opacity:0}to{opacity:1}}

  /*
    Duotone in brand indigo. Shadows land on --indigo-deep, highlights on
    --paper, so inconsistent source material stops mattering (spec §2).
    Two blend layers rather than an SVG filter — cheaper to composite and
    no Safari filter quirks.
  */
  .duotone{isolation:isolate;background:var(--indigo-deep)}
  .duotone :global(img){filter:grayscale(1) contrast(1.08);mix-blend-mode:screen}
  .duotone::after{content:'';position:absolute;inset:0;z-index:2;background:var(--paper);mix-blend-mode:multiply;pointer-events:none}

  figcaption{position:absolute;left:0;right:0;bottom:0;z-index:3;padding:.6rem .85rem;font-size:.74rem;color:#fff;background:linear-gradient(transparent,rgba(12,21,48,.72))}

  /* Plate fallback: art-directed today, replaceable by a photograph later. */
  .slot-plate{position:relative;background:var(--ink);color:var(--indigo-lite);border-radius:6px}
  .slot-plate::before{display:none}
  .slot-tag{position:absolute;left:.7rem;bottom:.6rem;z-index:4;font-size:.66rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:rgba(255,255,255,.42)}

  @media (prefers-reduced-motion:reduce){
    .slot :global(img){animation:none}
  }
</style>
