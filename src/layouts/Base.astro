---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import GuillocheDefs from '../components/GuillocheDefs.astro';
import { SITE } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Omit to derive from the current URL. */
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Path under /public. Falls back to the brand card. */
  ogImage?: string;
  /** JSON-LD graph nodes to emit in <head>. */
  schema?: Record<string, unknown>[];
}

const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';


const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, SITE.url).href,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/og-default.jpg',
  schema = [],
} = Astro.props;

/* Social cards need an absolute URL — a root-relative path renders blank. */
const ogImageUrl = new URL(ogImage, SITE.url).href;
---
<!DOCTYPE html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="en_NZ" />

  {/*
    Without these, a link pasted into WhatsApp, Facebook or LinkedIn renders
    as a bare grey box — and for this audience those are the channels a
    recommendation actually travels through.
  */}
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="iVISALAW — licensed immigration advisers, central Auckland" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#3852B3" />

  {/*
    Any build that is not the live ivisalaw.co.nz site must not be indexed.
    A pre-launch preview of a licensed adviser's site — carrying placeholder
    IAA licence numbers and policy figures the client has not signed off —
    competing with or being mistaken for their real site in search results
    would be a genuine problem, not a cosmetic one. Set PUBLIC_PREVIEW=true
    for every preview deploy.
  */}
  {isPreview && <meta name="robots" content="noindex, nofollow" />}

  {/*
    Fonts are self-hosted (see global.css §0). Preloading the two faces that
    paint above the fold — the display serif and the body sans — starts them
    in parallel with the stylesheet rather than after it. The italic is not
    preloaded: it sets only the brand mark, and can arrive late.
  */}
  <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/public-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

  {schema.map(node => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(node)} />
  ))}

  <ClientRouter />
</head>
<body>
  <div id="prog" aria-hidden="true"></div>
  <a class="skip" href="#main">Skip to content</a>

  <GuillocheDefs />
  <Header />

  <main id="main">
    <slot />
  </main>

  <Footer />
  <MobileCta />

  <script>
    import { boot } from '../scripts/site';
    boot();
  </script>
</body>
</html>
